---
title: Matchmaker — Crush Fleet Orchestration (Design)
---
flowchart TB
    subgraph INTAKE["Intake"]
        USER(["Operator CLI / TUI<br/>local Unix RPC"])
        FUTURE(["Future: cron, webhooks,<br/>issue labels — §8"])
    end

    subgraph MM["Matchmaker daemon — single state owner (§3)"]
        subgraph CORE["Core loops"]
            RECON["Immediate startup + ~30s reconcile<br/>observe · compare · converge<br/>health · version/build_id · SSE status<br/>start/adopt/drain/quarantine instances"]
            DISP["Dispatch<br/>frozen targets + ordered attempts<br/>gate on needs · per-instance serialization"]
            SUP["Supervision<br/>v1 policy: deny / grant_all<br/>timeout → cancelling → confirm/restart"]
            AGG["Aggregation<br/>target → step → goal rollups<br/>succeeded · failed · partial"]
        end

        STORE[("SQLite store (§9.2)<br/>goals · steps · runs · notes · instance state<br/>persisted before dispatch")]
        NOTES["Coordination MCP server (§5.4)<br/>bounded + rate-limited<br/>note_send(from,to) · note_read(for) · result_read"]
    end

    CONFIG["Fleet config (static)<br/>name · path · port · tags · typed options<br/>allowlist + collision validation"]

    subgraph FLEET["Fleet — one crush server per project (127.0.0.1 only)"]
        direction TB
        S1["crush server :41001<br/>/repo/a"]
        S2["crush server :41002<br/>/repo/b"]
        S3["crush server :41003<br/>/repo/c"]
        SN["crush server :41xxx<br/>/repo/…"]
        W1["workspace + session<br/>(agent runs here)"]
        W2["workspace + session"]
        W3["workspace + session"]
        WN["workspace + session"]
        S1 --- W1
        S2 --- W2
        S3 --- W3
        SN --- WN
    end

    USER -->|"goal: steps, needs,<br/>supervision, timeouts"| DISP
    FUTURE -.-> DISP
    CONFIG -->|"desired state + validation snapshot"| RECON
    DISP <-->|"validate atomically<br/>persist frozen expansion"| STORE
    SUP <-->|"state transitions"| STORE
    AGG <-->|"source of truth"| STORE
    RECON <-->|"instance state"| STORE

    RECON -->|"spawn os/exec<br/>crush server -H tcp://…<br/>POST workspace(path)"| S1
    RECON --> S2
    RECON --> S3
    RECON --> SN

    DISP -->|"POST agent: dedicated session + RunID<br/>templated prompt + injected notes"| W1
    DISP --> W2
    DISP --> W3
    DISP --> WN

    W1 ==>|"SSE events: message, permission_request, run_complete(RunID)"| SUP
    W2 ==> SUP
    W3 ==> SUP
    WN ==> SUP

    SUP -->|"allow / deny / question cancel / run cancel"| W1

    W1 <-->|"note_send / note_read / result_read"| NOTES
    W2 <-->|"note_send / note_read / result_read"| NOTES
    W3 <-->|"note_send / note_read / result_read"| NOTES
    WN <-->|"note_send / note_read / result_read"| NOTES
    NOTES <-->|"notes + delivery cursors"| STORE

    SUP -->|"events + results"| AGG
    AGG -->|"per-goal report via local RPC"| USER

    classDef future stroke-dasharray: 5 5,opacity:.7
    class FUTURE future
    classDef store fill:#fdf0d5,stroke:#8a6d00
    class STORE store
    classDef secret fill:#ffe5e5,stroke:#a00
